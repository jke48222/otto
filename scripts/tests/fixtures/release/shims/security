#!/bin/bash
# security shim: never touches a Keychain.
#   SHIM_IDENTITY=1            find-identity lists a fixture Developer ID Application identity
#   SHIM_POLAR_CANARY_KEY      the Polar canary (otto-release / polar-canary); unset = not found (exit 44)
#   SHIM_GUMROAD_CANARY_KEY    the Gumroad canary (otto-release / gumroad-canary); unset = not found (exit 44)
echo "security $*" >>"${SHIM_LOG:?}"
case "$1" in
    find-identity)
        if [ "${SHIM_IDENTITY:-0}" = 1 ]; then
            echo '  1) 0123456789ABCDEF0123456789ABCDEF01234567 "Developer ID Application: Otto Fixture (ABCDE12345)"'
            echo '     1 valid identities found'
        else
            echo '     0 valid identities found'
        fi
        exit 0
        ;;
    find-generic-password)
        service=""
        account=""
        shift
        while [ $# -gt 0 ]; do
            case "$1" in
                -s) service=$2; shift 2 ;;
                -a) account=$2; shift 2 ;;
                *) shift ;;
            esac
        done
        value=""
        if [ "$service" = otto-release ] && [ "$account" = polar-canary ]; then value=${SHIM_POLAR_CANARY_KEY:-}; fi
        if [ "$service" = otto-release ] && [ "$account" = gumroad-canary ]; then value=${SHIM_GUMROAD_CANARY_KEY:-}; fi
        if [ -z "$value" ]; then
            echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2
            exit 44
        fi
        printf '%s\n' "$value"
        exit 0
        ;;
esac
echo "security shim: unexpected command $1" >&2
exit 1
